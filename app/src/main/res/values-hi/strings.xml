    <!-- Backup -->
    <string name="backup">बैकअप</string>
    <string name="backup_supporting_text">अपनी प्लेलिस्ट और पसंदीदा ट्रैक को अपने नियंत्रण वाली फ़ाइल में सहेजें। उन्हें बाद में पुनर्स्थापित करें।</string>
    <string name="backup_export">बैकअप सहेजें</string>
    <string name="backup_import">फ़ाइल से पुनर्स्थापित करें</string>
    <string name="backup_what_is_included">फ़ाइल में क्या शामिल है</string>
    <string name="backup_what_is_included_body">आपकी प्लेलिस्ट (नाम + उनमें मौजूद ट्रैक) और पसंदीदा ट्रैक। यह सादा JSON है — यदि आप देखना चाहते हैं कि वास्तव में क्या सहेजा गया है, तो इसे किसी भी टेक्स्ट एडिटर में खोलें। सेटिंग्स, बोल (लिरिक्स) कैश और क्रैश लॉग शामिल नहीं हैं।</string>
    <string name="backup_import_policy_title">पुनर्स्थापना कैसे काम करती है</string>
    <string name="backup_import_policy_body">पुनर्स्थापना योगात्मक (additive) है। समान नाम वाली मौजूदा प्लेलिस्ट रखी जाती हैं; केवल नई जोड़ी जाती हैं। पसंदीदा ट्रैक मिला दिए जाते हैं। वे ट्रैक जिनकी फ़ाइलें डिवाइस से हटा दी गई हैं, छोड़ दिए जाते हैं।</string>
    <string name="backup_import_confirm_title">इस फ़ाइल से पुनर्स्थापित करें?</string>
    <string name="backup_import_confirm_body">लोटस चयनित फ़ाइल को पढ़ेगा और आपकी लाइब्रेरी में नई चीजें जोड़ेगा। जो कुछ भी पहले से इस डिवाइस पर है, उसे हटाया नहीं जाएगा।</string>
    <string name="backup_import_confirm_yes">पुनर्स्थापित करें</string>
    <string name="backup_export_success">%1$d प्लेलिस्ट, %2$d पसंदीदा ट्रैक, और %3$d प्ले आँकड़े सहेजे गए।</string>
