    <!-- Search tips dialog -->
    <string name="got_it">समझ गया</string>
    <string name="search_tips">खोज युक्तियाँ</string>
    <string name="search_explain">हम ट्रैक के बारे में जानकारी खोजने में आपकी सहायता करने के लिए MusicBrainz API का उपयोग करते हैं।</string>
    <string name="recipe_header">त्वरित विधि</string>
    <string name="recipe_explain">सबसे सटीक परिणामों के लिए, कलाकार और रिकॉर्डिंग को एक साथ उद्धरण चिह्नों (quotes) में खोजें। फ़ील्ड के नाम लोअरकेस या अपरकेस हो सकते हैं, लेकिन शब्द AND अपरकेस होना चाहिए:</string>
    <string name="recipe_example">artist:\"Alter Bridge\" AND recording:\"Slip to the Void\"</string>
    <string name="recipe_caution">उद्धरण चिह्न AND को काम करने देते हैं। उनके बिना, पूरी लाइन को सादे पाठ के रूप में माना जाता है, और एक सादी खोज केवल गीत के शीर्षकों से मेल खाती है — इसलिए उद्धरणों के बिना किसी गीत और उसके कलाकार को एक साथ खोजने से कलाकार के नाम वाले गीत ही मिलते हैं।</string>
    <string name="quotes_explain_header">सटीक मिलान के लिए उद्धरण</string>
    <string name="quotes_explain">विशिष्ट शब्दों या वाक्यांशों को खोजने के लिए उद्धरण चिह्नों का उपयोग करें:</string>
    <string name="quotes_example_1">\"4:44\"</string>
    <string name="quotes_example_2"><![CDATA[\"7 Weeks & 3 Days\"]]></string>
    <string name="field_explain_header">फ़ील्ड खोज</string>
    <string name="field_explain">आप कलाकार, एल्बम, या रिकॉर्डिंग (ट्रैक) के नाम से खोज सकते हैं:</string>
    <string name="field_example_1">artist:\"Jay-Z\"</string>
    <string name="field_example_2">release:\"Over You\"</string>
    <string name="field_example_3">recording:\"Still Falling For You\"</string>
    <string name="field_reference_header">फ़ील्ड संदर्भ</string>
    <string name="field_reference_explain">artist: — कलाकार या प्रदर्शक का नाम\nrecording: — गीत या ट्रैक का शीर्षक (इसका उपयोग करें, track: का नहीं)\nrelease: — एल्बम, ईपी, या एकल का नाम\n\nयुक्ति: MusicBrainz में track: एक मान्य फ़ील्ड नहीं है — गीत के नाम के लिए recording: का उपयोग करें। MusicBrainz डिफ़ॉल्ट रूप से रिकॉर्डिंग शीर्षकों में खोजता है, इसलिए आप फ़ील्ड उपसर्ग के बिना भी खोज सकते हैं।</string>
    <string name="combine_explain_header">खोजों को मिलाना</string>
    <string name="combine_explain">खोजों को मिलाने के लिए AND, OR, NOT (अपरकेस में) का उपयोग करें। वे केवल तभी ऑपरेटर के रूप में काम करते हैं जब खोज में मेल खाने वाले उद्धरण चिह्नों की एक जोड़ी हो — अन्यथा उन्हें शाब्दिक शब्दों के रूप में माना जाता है:</string>
    <string name="combine_example">artist:\"Ellie Goulding\" AND recording:\"Still Falling For You\"</string>
    <string name="mbid_lookup_header">MusicBrainz ID लुकअप</string>
    <string name="mbid_lookup_explain">सटीक रिकॉर्डिंग खोजने के लिए MusicBrainz ID (UUID) पेस्ट करें, तब भी जब पाठ खोज विफल हो जाती है:</string>
    <string name="mbid_example">9c2e84b8-1234-5678-9abc-def012345678</string>
    <string name="duration_toggle_header">अवधि मिलाएं</string>
    <string name="duration_toggle_explain">सक्षम होने पर, खोज परिणामों को उन ट्रैकों के लिए फ़िल्टर किया जाता है जो आपकी फ़ाइल की अवधि के ±15 सेकंड के भीतर हैं। यदि आपको वह नहीं मिल रहा है जो आप खोज रहे हैं, तो इसे ड्रॉपडाउन मेनू से अक्षम करें।</string>

