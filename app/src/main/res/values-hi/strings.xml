    <!-- Risks of metadata editing dialog -->
    <string name="risks_of_metadata_editing">मेटाडेटा संपादन के जोखिम</string>
    <string name="risks_of_metadata_editing_explain">मेटाडेटा संपादित करना एक शक्तिशाली सुविधा है, लेकिन कभी-कभी चीजें गलत हो सकती हैं और ऑडियो फ़ाइल टैग उम्मीद के मुताबिक काम नहीं कर सकते हैं।\n\nहम अनुशंसा करते हैं कि आप कोई भी परिवर्तन करने से पहले अपनी ऑडियो फ़ाइलों का बैकअप लें — बाद में पछताने से बेहतर है सुरक्षित रहना!\n\n\"स्वीकार करें\" पर क्लिक करके, आप मानते हैं कि आप अपनी फ़ाइलों के लिए जिम्मेदार हैं, आपने आवश्यक बैकअप ले लिए हैं, और यदि कुछ अप्रत्याशित होता है तो हम जिम्मेदार नहीं होंगे।\n\nयदि आप आगे नहीं बढ़ना चाहते हैं तो \"रद्द करें\" पर क्लिक करें।</string>
    <string name="accept">स्वीकार करें</string>
    <string name="cancel">रद्द करें</string>

