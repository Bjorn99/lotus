    <!-- Search tips dialog -->
    <string name="got_it">Ho capito</string>
    <string name="search_tips">Suggerimenti di ricerca</string>
    <string name="search_explain">Utilizziamo l\'API di MusicBrainz per aiutarti a trovare le info sulle tracce.</string>
    <string name="recipe_header">Metodo rapido</string>
    <string name="recipe_explain">Per risultati più precisi, cerca l\'artista e la registrazione insieme, racchiudendo ogni valore tra virgolette. I nomi dei campi possono essere scritti in maiuscolo o minuscolo, ma AND deve essere in maiuscolo:</string>
    <string name="recipe_example">artist:\"Alter Bridge\" AND recording:\"Slip to the Void\"</string>
    <string name="recipe_caution">Le virgolette fanno funzionare l\'AND. Senza di esse l\'intera riga viene trattata come testo semplice, e una semplice ricerca corrisponde solo ai titoli delle canzoni — quindi cercare una canzone e il suo artista insieme, senza virgolette, tende a trovare canzoni intitolate con il nome dell\'artista.</string>
    <string name="quotes_explain_header">Virgolette per corrispondenze esatte</string>
    <string name="quotes_explain">Usa le virgolette per trovare parole o frasi specifiche:</string>
    <string name="quotes_example_1">\"4:44\"</string>
    <string name="quotes_example_2"><![CDATA[\"7 Weeks & 3 Days\"]]></string>
    <string name="field_explain_header">Ricerca per campo</string>
    <string name="field_explain">Puoi cercare per nome dell\'artista, dell\'album o della registrazione (traccia):</string>
    <string name="field_example_1">artist:\"Jay-Z\"</string>
    <string name="field_example_2">release:\"Over You\"</string>
    <string name="field_example_3">recording:\"Still Falling For You\"</string>
    <string name="field_reference_header">Riferimento dei campi</string>
    <string name="field_reference_explain">artist: — nome dell\'artista o dell\'esecutore\nrecording: — titolo della canzone o della traccia (usa questo, non track:)\nrelease: — nome dell\'album, dell\'EP o del singolo\n\nSuggerimento: track: non è un campo MusicBrainz valido — usa recording: per i nomi delle canzoni. MusicBrainz cerca di default nei titoli delle registrazioni, quindi puoi anche cercare senza prefisso del campo.</string>
    <string name="combine_explain_header">Combina ricerche</string>
    <string name="combine_explain">Usa AND, OR, NOT (in maiuscolo) per combinare le ricerche. Agiscono come operatori solo se la query contiene una coppia di virgolette corrispondenti — altrimenti vengono trattati come parole letterali:</string>
    <string name="combine_example">artist:\"Ellie Goulding\" AND recording:\"Still Falling For You\"</string>
    <string name="mbid_lookup_header">Ricerca per ID MusicBrainz</string>
    <string name="mbid_lookup_explain">Incolla un ID MusicBrainz (UUID) per trovare la registrazione esatta, anche quando la ricerca testuale fallisce:</string>
    <string name="mbid_example">9c2e84b8-1234-5678-9abc-def012345678</string>
    <string name="duration_toggle_header">Corrispondenza della durata</string>
    <string name="duration_toggle_explain">Se abilitato, i risultati della ricerca sono filtrati alle tracce entro ±15 secondi dalla durata del tuo file. Disabilitalo dal menu se non riesci a trovare ciò che cerchi.</string>

