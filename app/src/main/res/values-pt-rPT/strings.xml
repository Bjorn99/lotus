    <!-- Search tips dialog -->
    <string name="got_it">Entendido</string>
    <string name="search_tips">Dicas de pesquisa</string>
    <string name="search_explain">Usamos a API do MusicBrainz para ajudar a encontrar informações sobre as faixas.</string>
    <string name="recipe_header">Método rápido</string>
    <string name="recipe_explain">Para resultados mais precisos, pesquise o artista e a gravação juntos, entre aspas. Os nomes dos campos podem estar em maiúsculas ou minúsculas, mas a palavra AND tem de estar em maiúsculas:</string>
    <string name="recipe_example">artist:\"Alter Bridge\" AND recording:\"Slip to the Void\"</string>
    <string name="recipe_caution">As aspas fazem o AND funcionar. Sem elas, toda a linha é tratada como texto simples e uma pesquisa simples só corresponde a títulos de músicas — assim, pesquisar uma música e o seu artista juntos sem aspas tende a encontrar músicas com o nome do artista.</string>
    <string name="quotes_explain_header">Aspas para correspondências exatas</string>
    <string name="quotes_explain">Use aspas para encontrar palavras ou frases específicas:</string>
    <string name="quotes_example_1">\"4:44\"</string>
    <string name="quotes_example_2"><![CDATA[\"7 Weeks & 3 Days\"]]></string>
    <string name="field_explain_header">Pesquisa por campo</string>
    <string name="field_explain">Pode pesquisar por nome de artista, álbum ou gravação (faixa):</string>
    <string name="field_example_1">artist:\"Jay-Z\"</string>
    <string name="field_example_2">release:\"Over You\"</string>
    <string name="field_example_3">recording:\"Still Falling For You\"</string>
    <string name="field_reference_header">Referência de campos</string>
    <string name="field_reference_explain">artist: — nome do artista ou intérprete\nrecording: — título da música ou faixa (use este, não track:)\nrelease: — nome do álbum, EP ou single\n\nDica: track: não é um campo válido no MusicBrainz — use recording: para nomes de músicas. O MusicBrainz pesquisa em títulos de gravações por predefinição, portanto também pode pesquisar sem o prefixo do campo.</string>
    <string name="combine_explain_header">Combinar pesquisas</string>
    <string name="combine_explain">Use AND, OR, NOT (em maiúsculas) para combinar pesquisas. Apenas funcionam como operadores se a pesquisa contiver um par de aspas correspondentes — caso contrário, são tratados como palavras literais:</string>
    <string name="combine_example">artist:\"Ellie Goulding\" AND recording:\"Still Falling For You\"</string>
    <string name="mbid_lookup_header">Pesquisa por ID do MusicBrainz</string>
    <string name="mbid_lookup_explain">Cole um ID do MusicBrainz (UUID) para encontrar a gravação exata, mesmo quando a pesquisa por texto falhar:</string>
    <string name="mbid_example">9c2e84b8-1234-5678-9abc-def012345678</string>
    <string name="duration_toggle_header">Corresponder duração</string>
    <string name="duration_toggle_explain">Quando ativado, os resultados da pesquisa são filtrados para faixas com variação de ±15 segundos da duração do seu ficheiro. Desative no menu pendente se não encontrar o que procura.</string>

