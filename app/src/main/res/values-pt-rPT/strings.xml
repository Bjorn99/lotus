    <!-- Risks of metadata editing dialog -->
    <string name="risks_of_metadata_editing">Riscos ao editar metadados</string>
    <string name="risks_of_metadata_editing_explain">Editar metadados é uma funcionalidade poderosa, mas por vezes algo pode correr mal e as tags dos ficheiros de áudio podem não se comportar como esperado.\n\nRecomendamos fazer uma cópia de segurança dos seus ficheiros de áudio antes de fazer alterações — mais vale prevenir do que remediar!\n\nAo clicar em \"Aceitar\", reconhece que é responsável pelos seus ficheiros, que fez as cópias de segurança necessárias e que não seremos responsabilizados se algo imprevisto acontecer.\n\nClique em \"Cancelar\" se preferir não prosseguir.</string>
    <string name="accept">Aceitar</string>
    <string name="cancel">Cancelar</string>

