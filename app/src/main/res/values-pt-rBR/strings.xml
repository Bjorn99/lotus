    <!-- Risks of metadata editing dialog -->
    <string name="risks_of_metadata_editing">Riscos ao editar metadados</string>
    <string name="risks_of_metadata_editing_explain">Editar metadados é um recurso poderoso, mas às vezes algo pode dar errado e as tags dos arquivos de áudio podem não se comportar como esperado.\n\nRecomendamos fazer backup dos seus arquivos de áudio antes de fazer alterações — é melhor prevenir do que remediar!\n\nAo clicar em \"Aceitar\", você reconhece que é responsável por seus arquivos, que fez os backups necessários e que não seremos responsabilizados se algo imprevisto acontecer.\n\nClique em \"Cancelar\" se preferir não prosseguir.</string>
    <string name="accept">Aceitar</string>
    <string name="cancel">Cancelar</string>

