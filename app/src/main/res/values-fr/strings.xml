    <!-- Search tips dialog -->
    <string name="got_it">Compris</string>
    <string name="search_tips">Astuces de recherche</string>
    <string name="search_explain">Nous utilisons l\'API de MusicBrainz pour vous aider à trouver les infos de vos pistes.</string>
    <string name="recipe_header">Méthode rapide</string>
    <string name="recipe_explain">Pour des résultats plus précis, recherchez l\'artiste et l\'enregistrement ensemble, en plaçant chaque valeur entre guillemets. Les noms de champs peuvent être écrits avec ou sans majuscules, mais le mot AND doit être en majuscules :</string>
    <string name="recipe_example">artist:\"Alter Bridge\" AND recording:\"Slip to the Void\"</string>
    <string name="recipe_caution">Ce sont les guillemets qui font fonctionner le AND. Sans eux, toute la ligne est traitée comme du texte brut, et une recherche simple correspond uniquement aux titres de chansons — donc chercher une chanson et son artiste ensemble, sans guillemets, trouve généralement des chansons portant le nom de l\'artiste.</string>
    <string name="quotes_explain_header">Guillemets pour les correspondances exactes</string>
    <string name="quotes_explain">Utilisez des guillemets pour trouver des mots ou phrases spécifiques :</string>
    <string name="quotes_example_1">\"4:44\"</string>
    <string name="quotes_example_2"><![CDATA[\"7 Weeks & 3 Days\"]]></string>
    <string name="field_explain_header">Recherche par champ</string>
    <string name="field_explain">Vous pouvez chercher par nom d\'artiste, d\'album ou d\'enregistrement (piste) :</string>
    <string name="field_example_1">artist:\"Jay-Z\"</string>
    <string name="field_example_2">release:\"Over You\"</string>
    <string name="field_example_3">recording:\"Still Falling For You\"</string>
    <string name="field_reference_header">Référence des champs</string>
    <string name="field_reference_explain">artist: — nom de l\'artiste ou de l\'interprète\nrecording: — titre de la chanson ou de la piste (utilisez ceci, et non track:)\nrelease: — nom de l\'album, de l\'EP ou du single\n\nAstuce : track: n\'est pas un champ MusicBrainz valide — utilisez recording: pour les noms de chansons. MusicBrainz recherche par défaut dans les titres d\'enregistrements, vous pouvez donc aussi chercher sans préfixe de champ.</string>
    <string name="combine_explain_header">Combiner les recherches</string>
    <string name="combine_explain">Utilisez AND, OR, NOT (en majuscules) pour combiner les recherches. Ils ne servent d\'opérateurs que si la requête contient une paire de guillemets appariée — sinon, ils sont traités comme de simples mots :</string>
    <string name="combine_example">artist:\"Ellie Goulding\" AND recording:\"Still Falling For You\"</string>
    <string name="mbid_lookup_header">Recherche par ID MusicBrainz</string>
    <string name="mbid_lookup_explain">Collez un ID MusicBrainz (UUID) pour trouver l\'enregistrement exact, même quand la recherche textuelle échoue :</string>
    <string name="mbid_example">9c2e84b8-1234-5678-9abc-def012345678</string>
    <string name="duration_toggle_header">Correspondance de la durée</string>
    <string name="duration_toggle_explain">Lorsqu\'elle est activée, les résultats de la recherche sont filtrés aux pistes situées à ±15 secondes de la durée de votre fichier. Désactivez-la via le menu si vous ne trouvez pas ce que vous cherchez.</string>

